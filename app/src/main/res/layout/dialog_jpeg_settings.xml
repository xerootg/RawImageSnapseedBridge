<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jpeg_settings_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Quality setting -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jpeg_quality_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <SeekBar
            android:id="@+id/seekJpegQuality"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="80"
            android:max="100"
            android:progress="95" />

        <TextView
            android:id="@+id/txtQualityValue"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="95"
            android:textAlignment="center"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jpeg_quality_hint"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp" />

    <!-- Chroma subsampling setting -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jpeg_chroma_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioGroupChroma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioChroma444"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chroma_444" />

        <RadioButton
            android:id="@+id/radioChroma422"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chroma_422" />

        <RadioButton
            android:id="@+id/radioChroma420"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chroma_420" />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jpeg_chroma_hint"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp" />

    <!-- Optimize Huffman tables setting -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <CheckBox
        android:id="@+id/chkOptimizeHuffman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jpeg_optimize_label"
        android:checked="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/jpeg_optimize_hint"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp" />

    <!-- OK button -->
    <Button
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:layout_marginTop="24dp" />

</LinearLayout>
