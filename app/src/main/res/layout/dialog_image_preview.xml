<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/previewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/image_preview" />

    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#88000000"
        android:orientation="vertical">

        <!-- Thumbnail strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/thumbnailStrip"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:scrollbars="none" />

        <!-- Top bar with filename and close button -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

        <TextView
            android:id="@+id/previewFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/previewFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnSelectImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_checkbox_unchecked"
            android:contentDescription="@string/select_image"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/selectionCountText"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:minWidth="24dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConvertJpeg"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:text="JPEG"
            android:textSize="12sp"
            android:minWidth="64dp"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnConvertDng"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text="DNG"
            android:textSize="12sp"
            android:minWidth="64dp"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnOpenWith"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text="@string/open_with_button"
            android:textSize="12sp"
            android:minWidth="96dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close_preview"
            app:tint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/zoom_controls_background"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/previous_image"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_zoom_out"
            android:contentDescription="@string/zoom_out"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnFitScreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_fit_screen"
            android:contentDescription="@string/fit_to_screen"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_zoom_in"
            android:contentDescription="@string/zoom_in"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="@string/next_image"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/zoomLevel"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
