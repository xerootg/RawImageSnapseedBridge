<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regenerate_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Output format selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regenerate_format_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioGroupFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioFormatDng"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/to_dng" />

        <RadioButton
            android:id="@+id/radioFormatJpeg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/to_jpeg"
            android:checked="true" />

    </RadioGroup>

    <!-- JPEG Settings Section (visible only when JPEG is selected) -->
    <LinearLayout
        android:id="@+id/jpegSettingsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <!-- Quality -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jpeg_quality_label"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekQuality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:min="1"
                android:max="100"
                android:progress="95" />

            <TextView
                android:id="@+id/txtQualityValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="95"
                android:textAlignment="center"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Chroma Subsampling -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jpeg_chroma_label"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupChroma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioChroma444"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chroma_444"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/radioChroma422"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chroma_422"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/radioChroma420"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chroma_420"
                android:textSize="13sp" />

        </RadioGroup>

        <!-- Optimize Huffman -->
        <CheckBox
            android:id="@+id/chkOptimize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jpeg_optimize_label"
            android:checked="true"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/btnRegenerate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/regenerate_button" />

    </LinearLayout>

</LinearLayout>
