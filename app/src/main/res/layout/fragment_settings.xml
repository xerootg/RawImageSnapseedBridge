<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Auto-navigate timeout setting -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autonav_timeout_label"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekAutonavTimeout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="30"
                android:progress="3" />

            <TextView
                android:id="@+id/txtAutonavValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="3s"
                android:textAlignment="center"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtAutonavWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autonav_zero_warning"
            android:textColor="#FF5722"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

        <!-- RAW file types setting -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/raw_types_label"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectRawTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:text="@string/raw_types_select" />

        <!-- Hide converted images setting -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <CheckBox
            android:id="@+id/chkHideConverted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_converted_label"
            android:checked="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_converted_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp" />

        <!-- Open single DNG in Snapseed setting -->
        <CheckBox
            android:id="@+id/chkOpenInSnapseed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/snapseed_label"
            android:checked="false"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtSnapseedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/snapseed_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp" />

        <!-- Share single JPEG setting -->
        <CheckBox
            android:id="@+id/chkShareJpeg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_jpeg_label"
            android:checked="false"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtShareJpegHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_jpeg_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp" />

        <!-- JPEG quality settings -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jpeg_settings_label"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnJpegSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:text="@string/jpeg_settings_button" />

        <!-- Licenses -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnLicenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.Button.TonalButton"
            android:text="@string/licenses_button" />

        <!-- Spacer at bottom for comfortable scrolling -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp" />

    </LinearLayout>

</ScrollView>
