<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/thumbnailContainer"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:layout_margin="4dp">

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#333333"
        android:contentDescription="@string/thumbnail" />

    <View
        android:id="@+id/selectionBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/thumbnail_strip_selected_border"
        android:visibility="gone" />

    <!-- Selection checkmark (green checkmark for selected images) -->
    <ImageView
        android:id="@+id/selectionCheckmark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:src="@drawable/ic_check_circle"
        app:tint="#4CAF50"
        android:visibility="gone"
        android:contentDescription="@string/select_image" />

    <!-- File type badge (DNG, JPEG) for gallery mode -->
    <TextView
        android:id="@+id/fileTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="#CC000000"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Conversion status badge (D, J, or D/J) -->
    <TextView
        android:id="@+id/conversionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="#CC000000"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:shadowColor="#FFFFFF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"
        android:visibility="gone" />

</FrameLayout>
